# ============================================================
# REQUIRED — App will NOT start without this
# ============================================================

# Get a free API key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# ============================================================
# OPTIONAL — App works without these (features degrade gracefully)
# Uncomment and fill in only what you need
# ============================================================

# Vertex AI (production LLM — falls back to AI Studio)
# GOOGLE_CLOUD_PROJECT=your_gcp_project_id
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}

# Gemini models — Google retires model IDs, so they live here, not in code
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# GEMINI_THINKING_LEVEL=low
# GEMINI_LOCATION=global

# Admin dashboard (protects /admin/* endpoints)
# ADMIN_API_KEY=your_secret_admin_key

# Langfuse (LLM tracing, cost tracking, and automated quality evaluation)
# LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
# LANGFUSE_SECRET_KEY=your_langfuse_secret_key
# LANGFUSE_HOST=https://us.cloud.langfuse.com

# Supabase (session persistence — falls back to in-memory cache)
# SUPABASE_URL=your_supabase_project_url
# SUPABASE_KEY=your_supabase_service_role_key

# Google Sheets (lead capture webhook)
# GOOGLE_SHEET_WEBHOOK=your_google_apps_script_webhook_url

# Cloudflare Turnstile (bot protection — disabled if absent)
# TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Sessions and quotas
# SESSION_SECRET=a-long-random-string      # signs chat session tokens; without it tokens die on restart
# SESSION_TTL_HOURS=24
# QUOTA_MESSAGES_PER_SESSION=40
# QUOTA_MESSAGES_PER_IP_PER_DAY=80
# QUOTA_SESSIONS_PER_IP_PER_DAY=15
# QUOTA_DAILY_TOKEN_BUDGET=3000000         # input + output tokens per UTC day across all chats

# Origin lock: set once the API is proxied through Cloudflare, which adds this header
# ORIGIN_SECRET=another-long-random-string

# App config
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
RATE_LIMIT_RPM=10
